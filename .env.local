# ============================================================
# EMERGENT 2.0 — Environment Variables
# ============================================================

# --- SUPABASE ---
# Create a project at https://supabase.com and copy these values
# from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- GOOGLE GEMINI ---
# Create an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INITIAL_CREDITS=10
NEXT_PUBLIC_CREDITS_PER_MESSAGE=0.5
